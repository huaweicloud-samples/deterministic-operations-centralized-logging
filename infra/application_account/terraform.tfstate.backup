                "readonly": false,
                "restart_required": true,
                "type": "string",
                "value": "MINIMAL",
                "value_range": "FULL|MINIMAL"
              },
              {
                "description": "Once the parameter is enabled, a MySQL 5.6.2 or later server writes information to log events, such as writing row query log events into its binary log.",
                "name": "binlog_rows_query_log_events",
                "readonly": false,
                "restart_required": false,
                "type": "boolean",
                "value": "OFF",
                "value_range": "ON|OFF"
              },
              {
                "description": "This variable determines the size (in bytes) of the cache for the binary log to hold non-transactional statements issued during a transaction. The parameter value must be a multiple of 4096.",
                "name": "binlog_stmt_cache_size",
                "readonly": false,
                "restart_required": false,
                "type": "integer",
                "value": "32768",
                "value_range": "4096-16777216"
              },
              {
                "description": "Sets an upper limit on the number of row hashes which are kept in memory and used for looking up that last modified a given row. Once this number of hashes has been reached, the history is purged.",
