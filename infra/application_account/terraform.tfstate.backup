      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "configuration_parameters": [
              {
                "description": "auto_increment_increment and auto_increment_offset control operations in the AUTO_INCREMENT columns, and are used for master-to-master replication.",
                "name": "auto_increment_increment",
                "readonly": false,
                "restart_required": false,
                "type": "integer",
                "value": "1",
                "value_range": "1-65535"
              },
              {
                "description": "auto_increment_increment and auto_increment_offset control operations in the AUTO_INCREMENT columns, and are used for master-to-master replication.",
